// OpsLab CI/CD Pipeline：Build → Push → Deploy → Verify
//
// 部署环境：
//   Jenkins : http://10.0.0.18:30081  (K8s devops 命名空间)
//   Harbor  : http://10.0.0.18:30080  (admin / Harbor12345)
//   K8s API : k8s-master (10.0.0.18:6443)
//
// 凭证配置（Jenkins → Manage Credentials → Add）：
//   1. Username with password → ID: harbor-creds（admin / Harbor12345）
//   2. Secret text           → ID: kube-config（内容为 /root/.kube/config 的 base64）
//
// Harbor 项目：登录 30080 后台新建项目 ops-app（公开或私有）
// containerd 信任：所有 K8s 节点配置 k8s/containerd-harbor-hosts.toml

pipeline {
    agent any

    environment {
        HARBOR = '10.0.0.18:30080'
        IMAGE  = "${HARBOR}/ops-app/webapp:${env.BUILD_NUMBER}"
    }

    stages {
        stage('Build') {
            steps {
                sh 'docker build -t ${IMAGE} .'
            }
        }

        stage('Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'harbor-creds',
                                                 usernameVariable: 'U', passwordVariable: 'P')]) {
                    sh 'echo $P | docker login ${HARBOR} -u $U --password-stdin'
                    sh 'docker push ${IMAGE}'
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([string(credentialsId: 'kube-config', variable: 'KC')]) {
                    sh 'echo $KC | base64 -d > /tmp/kubeconfig && export KUBECONFIG=/tmp/kubeconfig && kubectl set image deploy/webapp webapp=${IMAGE} && kubectl rollout status deploy/webapp'
                }
            }
        }
    }

    post {
        success { echo "Deploy successful: ${IMAGE}" }
        failure { echo "Deploy failed: ${IMAGE}" }
    }
}
